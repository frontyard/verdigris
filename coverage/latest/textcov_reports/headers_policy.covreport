 1484|       |    // `Arc`, those three fields still are the components of the
 1485|       |    // vector.
 1486|   316k|    let shared = Box::new(MaybeUninit::<Shared>::uninit());
 1487|   316k|    let shared = Shared::init_to_raw(
 1488|   316k|        shared,
 1489|   316k|        Shared {
 1490|   316k|            buf,
 1491|   316k|            cap: offset.offset_from(buf) as usize + len,
 1492|   316k|            // Initialize refcount to 2. One for this reference, and one
 1493|   316k|            // for the new clone that will be returned from
 1494|   316k|            // `shallow_clone`.
 1495|   316k|            ref_cnt: AtomicUsize::new(2),
 1496|   316k|        },
