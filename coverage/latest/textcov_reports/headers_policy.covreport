 1498|       |
 1499|       |    // The pointer should be aligned, so this assert should
 1500|       |    // always succeed.
 1501|   523k|    debug_assert!(
 1502|      0|        0 == (shared as usize & KIND_MASK),
 1503|      0|        "internal: Box<Shared> should have an aligned pointer",
 1504|       |    );
