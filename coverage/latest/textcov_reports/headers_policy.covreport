 1541|  2.09M|unsafe fn release_shared(ptr: *mut Shared) {
 1542|       |    // `Shared` storage... follow the drop steps from Arc.
 1543|  2.09M|    if (*ptr).ref_cnt.fetch_sub(1, Ordering::Release) != 1 {
