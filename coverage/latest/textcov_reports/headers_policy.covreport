 1521|   523k|                ptr: offset,
 1522|   523k|                len,
 1523|   523k|                data: AtomicPtr::new(shared as _),
 1524|   523k|                vtable: &SHARED_VTABLE,
 1525|   523k|            }
 1526|       |        }
 1527|      0|        Err(actual) => {
 1528|       |            // The upgrade failed, a concurrent clone happened. Release
