  690|       |            d.deserialize_any(EntryVisitor).map(Entry)
  691|       |        }
  692|       |    }
  693|       |
  694|       |    struct EntryVisitor;
  695|       |
  696|       |    impl<'de> serde::de::Visitor<'de> for EntryVisitor {
  697|       |        type Value = UpstreamConfig;
  698|       |        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
  699|       |            f.write_str(EXPECTING)
  700|       |        }
  701|       |        fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<UpstreamConfig, E> {
  702|       |            Ok(one(vec![UpstreamServer::new(v.to_owned())]))
  703|       |        }
  704|       |        fn visit_seq<A: serde::de::SeqAccess<'de>>(self, s: A) -> Result<UpstreamConfig, A::Error> {
