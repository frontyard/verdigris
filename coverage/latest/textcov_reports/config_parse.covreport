  642|       |    use serde::de::{DeserializeSeed, IntoDeserializer, MapAccess};
  643|       |
  644|       |    const EXPECTING: &str =
  645|       |        "upstream entries must be a URL, URL list, { url, weight, backup } entry, or a table";
  646|       |
  647|       |    fn one(servers: Vec<UpstreamServer>) -> UpstreamConfig {
  648|       |        UpstreamConfig {
  649|       |            servers,
  650|       |            ..Default::default()
  651|       |        }
