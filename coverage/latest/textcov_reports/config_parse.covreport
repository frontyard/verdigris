  726|       |        }
  727|       |        fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<UpstreamConfig, E> {
  728|       |            Err(E::custom(EXPECTING))
  729|       |        }
  730|       |        fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<UpstreamConfig, E> {
  731|       |            Err(E::custom(EXPECTING))
  732|       |        }
  733|       |    }
  734|       |
  735|       |    struct MapVisitor;
  736|       |
  737|       |    impl<'de> serde::de::Visitor<'de> for MapVisitor {
  738|       |        type Value = BTreeMap<String, UpstreamConfig>;
  739|       |        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
  740|       |            f.write_str("a table of upstream clusters")
  741|       |        }
  742|       |        fn visit_map<A: MapAccess<'de>>(self, mut m: A) -> Result<Self::Value, A::Error> {
