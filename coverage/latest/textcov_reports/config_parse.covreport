  653|       |
  654|       |    /// Replays an already-read first key ahead of the rest of the map,
  655|       |    /// so the table can be dispatched on that key and still be
  656|       |    /// deserialized in one pass, without buffering it.
  657|       |    struct Prepend<A> {
  658|       |        first: Option<String>,
  659|       |        rest: A,
  660|       |    }
  661|       |
  662|       |    impl<'de, A: MapAccess<'de>> MapAccess<'de> for Prepend<A> {
  663|       |        type Error = A::Error;
  664|       |        fn next_key_seed<K: DeserializeSeed<'de>>(
  665|       |            &mut self,
  666|       |            seed: K,
  667|       |        ) -> Result<Option<K::Value>, A::Error> {
  668|       |            match self.first.take() {
  669|       |                Some(k) => seed.deserialize(k.into_deserializer()).map(Some),
  670|       |                None => self.rest.next_key_seed(seed),
  671|       |            }
  672|       |        }
  673|       |        fn next_value_seed<V: DeserializeSeed<'de>>(
  674|       |            &mut self,
  675|       |            seed: V,
  676|       |        ) -> Result<V::Value, A::Error> {
  677|       |            self.rest.next_value_seed(seed)
  678|       |        }
  679|       |        fn size_hint(&self) -> Option<usize> {
  680|       |            self.rest
  681|       |                .size_hint()
  682|       |                .map(|n| n + usize::from(self.first.is_some()))
  683|       |        }
  684|       |    }
