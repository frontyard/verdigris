  709|       |            // `backup` are not UpstreamConfig fields, so the first key
  710|       |            // disambiguates. The full table is deserialized directly so
  711|       |            // its own errors (unknown fields, `did you mean`) reach the user.
  712|       |            let first = m.next_key::<String>()?;
  713|       |            let server = matches!(first.as_deref(), Some("url" | "weight" | "backup"));
  714|       |            let map = MapAccessDeserializer::new(Prepend { first, rest: m });
  715|       |            if server {
