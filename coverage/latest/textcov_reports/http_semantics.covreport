 2397|  1.56M|    fn empty() -> Properties {
 2398|  1.56M|        let inner = PropertiesI {
 2399|  1.56M|            minimum_len: Some(0),
 2400|  1.56M|            maximum_len: Some(0),
 2401|  1.56M|            look_set: LookSet::empty(),
 2402|  1.56M|            look_set_prefix: LookSet::empty(),
 2403|  1.56M|            look_set_suffix: LookSet::empty(),
 2404|  1.56M|            look_set_prefix_any: LookSet::empty(),
 2405|  1.56M|            look_set_suffix_any: LookSet::empty(),
 2406|  1.56M|            // It is debatable whether an empty regex always matches at valid
 2407|  1.56M|            // UTF-8 boundaries. Strictly speaking, at a byte oriented view,
 2408|  1.56M|            // it is clearly false. There are, for example, many empty strings
 2409|  1.56M|            // between the bytes encoding a '☃'.
 2410|  1.56M|            //
 2411|  1.56M|            // However, when Unicode mode is enabled, the fundamental atom
 2412|  1.56M|            // of matching is really a codepoint. And in that scenario, an
 2413|  1.56M|            // empty regex is defined to only match at valid UTF-8 boundaries
 2414|  1.56M|            // and to never split a codepoint. It just so happens that this
 2415|  1.56M|            // enforcement is somewhat tricky to do for regexes that match
 2416|  1.56M|            // the empty string inside regex engines themselves. It usually
 2417|  1.56M|            // requires some layer above the regex engine to filter out such
 2418|  1.56M|            // matches.
 2419|  1.56M|            //
 2420|  1.56M|            // In any case, 'true' is really the only coherent option. If it
 2421|  1.56M|            // were false, for example, then 'a*' would also need to be false
 2422|  1.56M|            // since it too can match the empty string.
 2423|  1.56M|            utf8: true,
 2424|  1.56M|            explicit_captures_len: 0,
 2425|  1.56M|            static_explicit_captures_len: Some(0),
 2426|  1.56M|            literal: false,
 2427|  1.56M|            alternation_literal: false,
 2428|  1.56M|        };
 2429|  1.56M|        Properties(Box::new(inner))
 2430|  1.56M|    }
