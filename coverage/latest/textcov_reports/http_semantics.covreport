   43|       |        #[cfg(not(feature = "perf-literal-multisubstring"))]
   44|       |        {
   45|       |            None
   46|       |        }
   47|       |        #[cfg(feature = "perf-literal-multisubstring")]
   48|       |        {
   49|       |            // We only really support leftmost-first semantics. In
   50|       |            // theory we could at least support leftmost-longest, as the
   51|       |            // aho-corasick crate does, but regex-automata doesn't know about
   52|       |            // leftmost-longest currently.
   53|       |            //
   54|       |            // And like the aho-corasick prefilter, if we're using `All`
   55|       |            // semantics, then we can still use leftmost semantics for a
   56|       |            // prefilter. (This might be a suspicious choice for the literal
   57|       |            // engine, which uses a prefilter as a regex engine directly, but
   58|       |            // that only happens when using leftmost-first semantics.)
   59|  16.8k|            let (packed_match_kind, ac_match_kind) = match kind {
   60|  16.8k|                MatchKind::LeftmostFirst | MatchKind::All => (
   61|  16.8k|                    aho_corasick::packed::MatchKind::LeftmostFirst,
   62|  16.8k|                    aho_corasick::MatchKind::LeftmostFirst,
   63|  16.8k|                ),
   64|       |            };
   65|  16.8k|            let minimum_len =
   66|  16.8k|                needles.iter().map(|n| n.as_ref().len()).min().unwrap_or(0);
   67|  16.8k|            let packed = aho_corasick::packed::Config::new()
   68|  16.8k|                .match_kind(packed_match_kind)
   69|  16.8k|                .builder()
   70|  16.8k|                .extend(needles)
   71|  16.8k|                .build()?;
   72|  14.8k|            let anchored_ac = aho_corasick::dfa::DFA::builder()
   73|  14.8k|                .match_kind(ac_match_kind)
   74|  14.8k|                .start_kind(aho_corasick::StartKind::Anchored)
   75|  14.8k|                .prefilter(false)
   76|  14.8k|                .build(needles)
   77|  14.8k|                .ok()?;
   78|  14.8k|            Some(Teddy { searcher: packed, anchored_ac, minimum_len })
   79|       |        }
