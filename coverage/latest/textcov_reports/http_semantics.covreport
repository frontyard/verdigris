 2616|   821k|                    }
 2617|       |                }
 2618|  14.7k|            }
 2619|   839k|            if let Some(maximum_len) = props.maximum_len {
 2620|   682k|                match p.maximum_len() {
 2621|  50.6k|                    None => props.maximum_len = None,
 2622|   631k|                    Some(len) => {
 2623|   631k|                        props.maximum_len = maximum_len.checked_add(len)
