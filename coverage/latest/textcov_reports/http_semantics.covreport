 2471|  53.5k|    fn look(look: Look) -> Properties {
 2472|  53.5k|        let inner = PropertiesI {
 2473|  53.5k|            minimum_len: Some(0),
 2474|  53.5k|            maximum_len: Some(0),
 2475|  53.5k|            look_set: LookSet::singleton(look),
 2476|  53.5k|            look_set_prefix: LookSet::singleton(look),
 2477|  53.5k|            look_set_suffix: LookSet::singleton(look),
 2478|  53.5k|            look_set_prefix_any: LookSet::singleton(look),
 2479|  53.5k|            look_set_suffix_any: LookSet::singleton(look),
