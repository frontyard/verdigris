  904|       |    // names/aliases had a particular structure (unlike character names), but
  905|       |    // we assume that it's ASCII only and drop anything that isn't ASCII.
  906|     12|    let mut start = 0;
  907|     12|    let mut starts_with_is = false;
  908|     12|    if slice.len() >= 2 {
  909|       |        // Ignore any "is" prefix.
  910|      6|        starts_with_is = slice[0..2] == b"is"[..]
  911|      6|            || slice[0..2] == b"IS"[..]
  912|      6|            || slice[0..2] == b"iS"[..]
  913|      6|            || slice[0..2] == b"Is"[..];
  914|      6|        if starts_with_is {
  915|      0|            start = 2;
  916|      6|        }
  917|      6|    }
  918|     12|    let mut next_write = 0;
  919|     24|    for i in start..slice.len() {
  920|       |        // VALIDITY ARGUMENT: To guarantee that the resulting slice is valid
  921|       |        // UTF-8, we ensure that the slice contains only ASCII bytes. In
  922|       |        // particular, we drop every non-ASCII byte from the normalized string.
  923|     24|        let b = slice[i];
  924|     24|        if b == b' ' || b == b'_' || b == b'-' {
  925|      0|            continue;
  926|     24|        } else if b'A' <= b && b <= b'Z' {
  927|      4|            slice[next_write] = b + (b'a' - b'A');
  928|      4|            next_write += 1;
  929|     20|        } else if b <= 0x7F {
  930|      2|            slice[next_write] = b;
  931|      2|            next_write += 1;
  932|     18|        }
  933|       |    }
  934|       |    // Special case: ISO_Comment has a 'isc' abbreviation. Since we generally
  935|       |    // ignore 'is' prefixes, the 'isc' abbreviation gets caught in the cross
  936|       |    // fire and ends up creating an alias for 'c' to 'ISO_Comment', but it
  937|       |    // is actually an alias for the 'Other' general category.
  938|     12|    if starts_with_is && next_write == 1 && slice[0] == b'c' {
  939|      0|        slice[0] = b'i';
  940|      0|        slice[1] = b's';
  941|      0|        slice[2] = b'c';
  942|      0|        next_write = 3;
  943|     12|    }
  944|     12|    &mut slice[..next_write]
  945|     12|}
