  221|       |
  222|   102k|        let mut byte = b'0';
  223|  1.12M|        while byte <= b'9' {
  224|  1.02M|            map[usize::from(byte)] = Start::WordByte;
  225|  1.02M|            byte += 1;
  226|  1.02M|        }
  227|   102k|        byte = b'A';
  228|  2.75M|        while byte <= b'Z' {
  229|  2.65M|            map[usize::from(byte)] = Start::WordByte;
  230|  2.65M|            byte += 1;
  231|  2.65M|        }
  232|   102k|        byte = b'a';
  233|  2.75M|        while byte <= b'z' {
  234|  2.65M|            map[usize::from(byte)] = Start::WordByte;
  235|  2.65M|            byte += 1;
  236|  2.65M|        }
  237|       |
  238|   102k|        let lineterm = lookm.get_line_terminator();
