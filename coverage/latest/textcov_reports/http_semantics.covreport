  452|  9.53M|) {
  453|  19.0M|    for nfa_id in set.iter() {
  454|  19.0M|        match *nfa.state(nfa_id) {
  455|  8.76M|            thompson::State::ByteRange { .. } => {
  456|  8.76M|                builder.add_nfa_state_id(nfa_id);
  457|  8.76M|            }
  458|   271k|            thompson::State::Sparse { .. } => {
  459|   271k|                builder.add_nfa_state_id(nfa_id);
  460|   271k|            }
  461|      0|            thompson::State::Dense { .. } => {
  462|      0|                builder.add_nfa_state_id(nfa_id);
  463|      0|            }
  464|  94.9k|            thompson::State::Look { look, .. } => {
  465|  94.9k|                builder.add_nfa_state_id(nfa_id);
  466|  94.9k|                builder.set_look_need(|need| need.insert(look));
  467|       |            }
  468|       |            thompson::State::Union { .. }
  469|  7.24M|            | thompson::State::BinaryUnion { .. } => {
  470|  7.24M|                // Pure epsilon transitions don't need to be tracked as part
  471|  7.24M|                // of the DFA state. Tracking them is actually superfluous;
  472|  7.24M|                // they won't cause any harm other than making determinization
  473|  7.24M|                // slower.
  474|  7.24M|                //
  475|  7.24M|                // Why aren't these needed? Well, in an NFA, epsilon
  476|  7.24M|                // transitions are really just jumping points to other states.
  477|  7.24M|                // So once you hit an epsilon transition, the same set of
  478|  7.24M|                // resulting states always appears. Therefore, putting them in
  479|  7.24M|                // a DFA's set of ordered NFA states is strictly redundant.
  480|  7.24M|                //
  481|  7.24M|                // Look-around states are also epsilon transitions, but
  482|  7.24M|                // they are *conditional*. So their presence could be
  483|  7.24M|                // discriminatory, and thus, they are tracked above.
  484|  7.24M|                //
  485|  7.24M|                // But wait... why are epsilon states in our `set` in the first
  486|  7.24M|                // place? Why not just leave them out? They're in our `set`
  487|  7.24M|                // because it was generated by computing an epsilon closure,
  488|  7.24M|                // and we want to keep track of all states we visited to avoid
  489|  7.24M|                // re-visiting them. In exchange, we have to do this second
  490|  7.24M|                // iteration over our collected states to finalize our DFA
  491|  7.24M|                // state. In theory, we could avoid this second iteration if
  492|  7.24M|                // we maintained two sets during epsilon closure: the set of
  493|  7.24M|                // visited states (to avoid cycles) and the set of states that
  494|  7.24M|                // will actually be used to construct the next DFA state.
  495|  7.24M|                //
  496|  7.24M|                // Note that this optimization requires that we re-compute the
  497|  7.24M|                // epsilon closure to account for look-ahead in 'next' *only
  498|  7.24M|                // when necessary*. Namely, only when the set of look-around
  499|  7.24M|                // assertions changes and only when those changes are within
  500|  7.24M|                // the set of assertions that are needed in order to step
  501|  7.24M|                // through the closure correctly. Otherwise, if we re-do the
  502|  7.24M|                // epsilon closure needlessly, it could change based on the
  503|  7.24M|                // fact that we are omitting epsilon states here.
  504|  7.24M|                //
  505|  7.24M|                // -----
  506|  7.24M|                //
  507|  7.24M|                // Welp, scratch the above. It turns out that recording these
  508|  7.24M|                // is in fact necessary to seemingly handle one particularly
  509|  7.24M|                // annoying case: when a conditional epsilon transition is
  510|  7.24M|                // put inside of a repetition operator. One specific case I
  511|  7.24M|                // ran into was the regex `(?:\b|%)+` on the haystack `z%`.
  512|  7.24M|                // The correct leftmost first matches are: [0, 0] and [1, 1].
  513|  7.24M|                // But the DFA was reporting [0, 0] and [1, 2]. To understand
  514|  7.24M|                // why this happens, consider the NFA for the aforementioned
  515|  7.24M|                // regex:
  516|  7.24M|                //
  517|  7.24M|                //     >000000: binary-union(4, 1)
  518|  7.24M|                //      000001: \x00-\xFF => 0
  519|  7.24M|                //      000002: WordAscii => 5
  520|  7.24M|                //      000003: % => 5
