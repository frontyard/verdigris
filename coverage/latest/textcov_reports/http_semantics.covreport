 2494|  53.5k|            explicit_captures_len: 0,
 2495|  53.5k|            static_explicit_captures_len: Some(0),
 2496|  53.5k|            literal: false,
 2497|  53.5k|            alternation_literal: false,
 2498|  53.5k|        };
