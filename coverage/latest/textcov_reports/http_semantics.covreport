 2642|   110k|        while let Some(x) = it.next() {
 2643|   109k|            props.look_set_suffix.set_union(x.properties().look_set_suffix());
 2644|   109k|            props
 2645|   109k|                .look_set_suffix_any
 2646|   109k|                .set_union(x.properties().look_set_suffix_any());
 2647|   109k|            if x.properties().maximum_len().map_or(true, |x| x > 0) {
 2648|  85.2k|                break;
 2649|  23.9k|            }
