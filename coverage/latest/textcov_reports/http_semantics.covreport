 2591|   839k|        for x in concat.iter() {
 2592|   839k|            let p = x.properties();
 2593|   839k|            props.look_set.set_union(p.look_set());
 2594|   839k|            props.utf8 = props.utf8 && p.is_utf8();
 2595|   839k|            props.explicit_captures_len = props
 2596|   839k|                .explicit_captures_len
 2597|   839k|                .saturating_add(p.explicit_captures_len());
 2598|   839k|            props.static_explicit_captures_len = p
 2599|   839k|                .static_explicit_captures_len()
 2600|   839k|                .and_then(|len1| {
 2601|       |                    Some((len1, props.static_explicit_captures_len?))
 2602|       |                })
 2603|   839k|                .and_then(|(len1, len2)| Some(len1.saturating_add(len2)));
 2604|   839k|            props.literal = props.literal && p.is_literal();
 2605|       |            props.alternation_literal =
 2606|   839k|                props.alternation_literal && p.is_alternation_literal();
 2607|   839k|            if let Some(minimum_len) = props.minimum_len {
 2608|   824k|                match p.minimum_len() {
 2609|  2.70k|                    None => props.minimum_len = None,
 2610|   821k|                    Some(len) => {
 2611|   821k|                        // We use saturating arithmetic here because the
 2612|   821k|                        // minimum is just a lower bound. We can't go any
 2613|   821k|                        // higher than what our number types permit.
 2614|   821k|                        props.minimum_len =
