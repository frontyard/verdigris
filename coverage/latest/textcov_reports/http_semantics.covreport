 2573|       |        // string. Note though that empty concatenations aren't possible,
 2574|       |        // because the Hir::concat smart constructor rewrites those as
 2575|       |        // Hir::empty.
 2576|  86.1k|        let mut props = PropertiesI {
 2577|  86.1k|            minimum_len: Some(0),
 2578|  86.1k|            maximum_len: Some(0),
 2579|  86.1k|            look_set: LookSet::empty(),
 2580|  86.1k|            look_set_prefix: LookSet::empty(),
 2581|  86.1k|            look_set_suffix: LookSet::empty(),
 2582|  86.1k|            look_set_prefix_any: LookSet::empty(),
 2583|  86.1k|            look_set_suffix_any: LookSet::empty(),
 2584|  86.1k|            utf8: true,
 2585|  86.1k|            explicit_captures_len: 0,
 2586|  86.1k|            static_explicit_captures_len: Some(0),
 2587|  86.1k|            literal: true,
 2588|  86.1k|            alternation_literal: true,
 2589|  86.1k|        };
