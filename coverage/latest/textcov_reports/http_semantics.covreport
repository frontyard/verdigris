 4335|  59.6k|fn minimum_cache_capacity(
 4336|  59.6k|    nfa: &thompson::NFA,
 4337|  59.6k|    classes: &ByteClasses,
 4338|  59.6k|    starts_for_each_pattern: bool,
 4339|  59.6k|) -> usize {
 4340|       |    const ID_SIZE: usize = size_of::<LazyStateID>();
 4341|       |    const STATE_SIZE: usize = size_of::<State>();
 4342|       |
 4343|  59.6k|    let stride = 1 << classes.stride2();
 4344|  59.6k|    let states_len = nfa.states().len();
 4345|  59.6k|    let sparses = 2 * states_len * NFAStateID::SIZE;
 4346|  59.6k|    let trans = MIN_STATES * stride * ID_SIZE;
 4347|       |
