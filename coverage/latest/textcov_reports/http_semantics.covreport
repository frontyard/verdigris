  216|  87.1k|    pub(crate) fn new(lookm: &LookMatcher) -> StartByteMap {
  217|  87.1k|        let mut map = [Start::NonWordByte; 256];
  218|  87.1k|        map[usize::from(b'\n')] = Start::LineLF;
  219|  87.1k|        map[usize::from(b'\r')] = Start::LineCR;
  220|  87.1k|        map[usize::from(b'_')] = Start::WordByte;
  221|       |
  222|  87.1k|        let mut byte = b'0';
  223|   958k|        while byte <= b'9' {
  224|   871k|            map[usize::from(byte)] = Start::WordByte;
  225|   871k|            byte += 1;
  226|   871k|        }
  227|  87.1k|        byte = b'A';
  228|  2.35M|        while byte <= b'Z' {
  229|  2.26M|            map[usize::from(byte)] = Start::WordByte;
  230|  2.26M|            byte += 1;
  231|  2.26M|        }
  232|  87.1k|        byte = b'a';
  233|  2.35M|        while byte <= b'z' {
  234|  2.26M|            map[usize::from(byte)] = Start::WordByte;
  235|  2.26M|            byte += 1;
  236|  2.26M|        }
  237|       |
  238|  87.1k|        let lineterm = lookm.get_line_terminator();
  239|       |        // If our line terminator is normal, then it is already handled by
  240|       |        // the LineLF and LineCR configurations. But if it's weird, then we
  241|       |        // overwrite whatever was there before for that terminator with a
  242|       |        // special configuration. The trick here is that if the terminator
  243|       |        // is, say, a word byte like `a`, then callers seeing this start
  244|       |        // configuration need to account for that and build their DFA state as
  245|       |        // if it *also* came from a word byte.
  246|  87.1k|        if lineterm != b'\r' && lineterm != b'\n' {
  247|      0|            map[usize::from(lineterm)] = Start::CustomLineTerminator;
  248|  87.1k|        }
  249|  87.1k|        StartByteMap { map }
  250|  87.1k|    }

