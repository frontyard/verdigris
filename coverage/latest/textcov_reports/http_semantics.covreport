   28|       |        while byte <= b'Z' {
   29|       |            set[byte as usize] = true;
   30|       |            byte += 1;
   31|       |        }
   32|       |        byte = b'a';
   33|       |        while byte <= b'z' {
   34|       |            set[byte as usize] = true;
   35|       |            byte += 1;
   36|       |        }
   37|       |        set
