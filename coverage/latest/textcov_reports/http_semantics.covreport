 2503|   362k|    fn repetition(rep: &Repetition) -> Properties {
 2504|   362k|        let p = rep.sub.properties();
 2505|   362k|        let minimum_len = p.minimum_len().map(|child_min| {
 2506|       |            let rep_min = usize::try_from(rep.min).unwrap_or(usize::MAX);
 2507|       |            child_min.saturating_mul(rep_min)
 2508|       |        });
 2509|   362k|        let maximum_len = rep.max.and_then(|rep_max| {
 2510|       |            let rep_max = usize::try_from(rep_max).ok()?;
 2511|       |            let child_max = p.maximum_len()?;
 2512|       |            child_max.checked_mul(rep_max)
 2513|       |        });
 2514|       |
 2515|   362k|        let mut inner = PropertiesI {
 2516|   362k|            minimum_len,
 2517|   362k|            maximum_len,
 2518|   362k|            look_set: p.look_set(),
 2519|   362k|            look_set_prefix: LookSet::empty(),
 2520|   362k|            look_set_suffix: LookSet::empty(),
 2521|   362k|            look_set_prefix_any: p.look_set_prefix_any(),
 2522|   362k|            look_set_suffix_any: p.look_set_suffix_any(),
 2523|   362k|            utf8: p.is_utf8(),
 2524|   362k|            explicit_captures_len: p.explicit_captures_len(),
 2525|   362k|            static_explicit_captures_len: p.static_explicit_captures_len(),
 2526|   362k|            literal: false,
 2527|   362k|            alternation_literal: false,
 2528|   362k|        };
 2529|       |        // If the repetition operator can match the empty string, then its
 2530|       |        // lookset prefix and suffixes themselves remain empty since they are
 2531|       |        // no longer required to match.
 2532|   362k|        if rep.min > 0 {
 2533|  52.6k|            inner.look_set_prefix = p.look_set_prefix();
 2534|  52.6k|            inner.look_set_suffix = p.look_set_suffix();
 2535|   310k|        }
