  134|  11.1k|    fn is_fast(&self) -> bool {
  135|       |        #[cfg(not(feature = "perf-literal-multisubstring"))]
  136|       |        {
  137|       |            unreachable!()
  138|       |        }
  139|       |        #[cfg(feature = "perf-literal-multisubstring")]
  140|       |        {
  141|       |            // Teddy is usually quite fast, but I have seen some cases where
  142|       |            // a large number of literals can overwhelm it and make it not so
  143|       |            // fast. We make an educated but conservative guess at a limit, at
  144|       |            // which point, we're not so comfortable thinking Teddy is "fast."
  145|       |            //
  146|       |            // Well... this used to incorporate a "limit" on the *number*
  147|       |            // of literals, but I have since changed it to a minimum on the
  148|       |            // *smallest* literal. Namely, when there is a very small literal
  149|       |            // (1 or 2 bytes), it is far more likely that it leads to a higher
  150|       |            // false positive rate. (Although, of course, not always. For
  151|       |            // example, 'zq' is likely to have a very low false positive rate.)
  152|       |            // But when we have 3 bytes, we have a really good chance of being
  153|       |            // quite discriminatory and thus fast.
  154|       |            //
  155|       |            // We may still want to add some kind of limit on the number of
  156|       |            // literals here, but keep in mind that Teddy already has its own
  157|       |            // somewhat small limit (64 at time of writing). The main issue
  158|       |            // here is that if 'is_fast' is false, it opens the door for the
  159|       |            // reverse inner optimization to kick in. We really only want to
  160|       |            // resort to the reverse inner optimization if we absolutely must.
  161|  11.1k|            self.minimum_len >= 3
  162|       |        }
  163|  11.1k|    }

