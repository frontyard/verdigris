   39|  20.2k|    pub(crate) fn new<B: AsRef<[u8]>>(
   40|  20.2k|        kind: MatchKind,
   41|  20.2k|        needles: &[B],
   42|  20.2k|    ) -> Option<Teddy> {
   43|       |        #[cfg(not(feature = "perf-literal-multisubstring"))]
   44|       |        {
   45|       |            None
   46|       |        }
   47|       |        #[cfg(feature = "perf-literal-multisubstring")]
   48|       |        {
   49|       |            // We only really support leftmost-first semantics. In
   50|       |            // theory we could at least support leftmost-longest, as the
   51|       |            // aho-corasick crate does, but regex-automata doesn't know about
   52|       |            // leftmost-longest currently.
   53|       |            //
   54|       |            // And like the aho-corasick prefilter, if we're using `All`
   55|       |            // semantics, then we can still use leftmost semantics for a
   56|       |            // prefilter. (This might be a suspicious choice for the literal
   57|       |            // engine, which uses a prefilter as a regex engine directly, but
   58|       |            // that only happens when using leftmost-first semantics.)
   59|  20.2k|            let (packed_match_kind, ac_match_kind) = match kind {
   60|  20.2k|                MatchKind::LeftmostFirst | MatchKind::All => (
   61|  20.2k|                    aho_corasick::packed::MatchKind::LeftmostFirst,
   62|  20.2k|                    aho_corasick::MatchKind::LeftmostFirst,
   63|  20.2k|                ),
   64|       |            };
   65|  20.2k|            let minimum_len =
   66|  20.2k|                needles.iter().map(|n| n.as_ref().len()).min().unwrap_or(0);
   67|  20.2k|            let packed = aho_corasick::packed::Config::new()
   68|  20.2k|                .match_kind(packed_match_kind)
   69|  20.2k|                .builder()
   70|  20.2k|                .extend(needles)
   71|  20.2k|                .build()?;
   72|  16.3k|            let anchored_ac = aho_corasick::dfa::DFA::builder()
   73|  16.3k|                .match_kind(ac_match_kind)
   74|  16.3k|                .start_kind(aho_corasick::StartKind::Anchored)
   75|  16.3k|                .prefilter(false)
   76|  16.3k|                .build(needles)
   77|  16.3k|                .ok()?;
   78|  16.3k|            Some(Teddy { searcher: packed, anchored_ac, minimum_len })
   79|       |        }
   80|  20.2k|    }
