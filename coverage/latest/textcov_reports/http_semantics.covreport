_RNvNtNtCshOaWX7rkiNU_14regex_automata6hybrid3dfa22minimum_cache_capacity:
 4335|  45.1k|fn minimum_cache_capacity(
 4336|  45.1k|    nfa: &thompson::NFA,
 4337|  45.1k|    classes: &ByteClasses,
 4338|  45.1k|    starts_for_each_pattern: bool,
 4339|  45.1k|) -> usize {
 4340|       |    const ID_SIZE: usize = size_of::<LazyStateID>();
 4341|       |    const STATE_SIZE: usize = size_of::<State>();
 4342|       |
 4343|  45.1k|    let stride = 1 << classes.stride2();
 4344|  45.1k|    let states_len = nfa.states().len();
 4345|  45.1k|    let sparses = 2 * states_len * NFAStateID::SIZE;
 4346|  45.1k|    let trans = MIN_STATES * stride * ID_SIZE;
 4347|       |
 4348|  45.1k|    let mut starts = Start::len() * ID_SIZE;
 4349|  45.1k|    if starts_for_each_pattern {
 4350|  44.8k|        starts += (Start::len() * nfa.pattern_len()) * ID_SIZE;
 4351|  44.8k|    }
