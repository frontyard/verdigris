 3242|       |
 3243|       |                static AVAILABLE_PARALLELISM: Lazy<usize> = Lazy::new(|| {
 3244|       |                    std::thread::available_parallelism()
 3245|       |                        .map(|n| n.get())
 3246|       |                        .unwrap_or(DEFAULT_POOL_CAPACITY)
 3247|       |                });
